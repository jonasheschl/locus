# This repository is the application sibling of the knowledge spaces. Track application code and
# its bundled contract, not the owner's data, regardless of file type.
/*
!/.dockerignore
!/.gitignore
!/AGENTS.md
!/Dockerfile
!/README.md
!/backend/
!/docker-compose.yml
!/frontend/
!/agent-workspace/
/agent-workspace/*
!/agent-workspace/control/
/agent-workspace/control/*
!/agent-workspace/control/.gitkeep
!/agent-workspace/work/
/agent-workspace/work/*
!/agent-workspace/work/.gitkeep
